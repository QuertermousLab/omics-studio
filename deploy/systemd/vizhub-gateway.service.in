# GENERATED by ./vizhubctl configure from this template (deploy/systemd/*.in) and deploy/site.env.
[Unit]
Description=Omics Studio gateway (port @VIZHUB_PORT@, @VIZHUB_GATEWAY@): hub, Genome Canvas, GREAT, sign-in, Workbench@jupyter-label@
Wants=network-online.target @jupyter-unit@genome-canvas.service vizhub-great.service vizhub-auth.service vizhub-hub.service vizhub-workbench.service
After=network-online.target @jupyter-unit@genome-canvas.service vizhub-great.service vizhub-auth.service vizhub-hub.service vizhub-workbench.service

[Service]
Type=simple
@VIZHUB_GATEWAY_EXEC@
Restart=on-failure
RestartSec=5
PrivateTmp=true

[Install]
WantedBy=default.target
# genome-canvasctl (in genome-canvas/) still manages the gateway under its old name
Alias=genome-canvas-gateway.service
