# GENERATED by ./vizhubctl configure from this template (deploy/systemd/*.in) and deploy/site.env.
[Unit]
Description=Omics Studio AlphaGenome: starts and stops AlphaGenome on its GPU server and serves its Atlas through an SSH tunnel
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@VIZHUB_DIR@/alphagenome
ExecStart=/usr/bin/env python3 @VIZHUB_DIR@/alphagenome/server.py --host 127.0.0.1 --port @VIZHUB_ALPHAGENOME_PORT@ --tunnel-port @VIZHUB_ALPHAGENOME_TUNNEL_PORT@ --remote-port @VIZHUB_ALPHAGENOME_REMOTE_PORT@ --name @VIZHUB_ALPHAGENOME_NAME@ --idle-minutes @VIZHUB_ALPHAGENOME_IDLE_MINUTES@
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# the GPU server (user@host): deploy/site.env VIZHUB_ALPHAGENOME_SSH; empty = AlphaGenome is not set up
Environment=VIZHUB_ALPHAGENOME_SSH=@VIZHUB_ALPHAGENOME_SSH@
# Omics Studio sign-in (VIZHUB_SIGN_IN in deploy/site.env): the sessions it checks; empty = no sign-in
Environment=OMICS_CANVAS_AUTH=@VIZHUB_AUTH_STATE@

[Install]
WantedBy=default.target
