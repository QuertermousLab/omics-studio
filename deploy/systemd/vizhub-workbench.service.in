# GENERATED by ./vizhubctl configure from this template (deploy/systemd/*.in) and deploy/site.env.
[Unit]
Description=Omics Workbench: downloads, bulk and single-cell pipelines, server load (Omics Studio)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@VIZHUB_DIR@/workbench
ExecStart=/usr/bin/env python3 @VIZHUB_DIR@/workbench/server.py --host 127.0.0.1 --port @VIZHUB_WORKBENCH_PORT@ --public-url @VIZHUB_PUBLIC_URL@
Restart=on-failure
RestartSec=3
# jobs run detached (setsid) in their own process groups: stopping the service never stops them
KillMode=process
Environment=PYTHONUNBUFFERED=1
# Omics Studio sign-in (VIZHUB_SIGN_IN in deploy/site.env): the sessions it checks; empty = no sign-in
Environment=OMICS_CANVAS_AUTH=@VIZHUB_AUTH_STATE@

[Install]
WantedBy=default.target
